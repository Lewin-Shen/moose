[Tests]
  # The factored Schur shell of the split Cahn-Hilliard FieldSplit (SplitCHFactoredSchurPreconditioner)
  # on the square deck. The jacobian spec checks the deck's kernels on its SMP block, which never
  # constructs the shell. The RunException specs check the run-time requirements the object enforces.
  # The verify_apply groups run the shell with its diagnostic dump on and then the reference script
  # verify_apply.py on the dumps; each group first removes the dumps of an earlier run, because the
  # object refuses to overwrite a dump. The dumps are written under the run's file base. Every run
  # spec requires the counters the object prints at the end of the run to balance, and two specs run
  # on four processes with MUMPS factors. The object needs PETSc 3.20 or later.

  [jacobian]
    type = PetscJacobianTester
    input = square_split_ch.i
    cli_args = 'Preconditioning/active=smp_full Executioner/num_steps=1'
    ratio_tol = 5e-8
    difference_tol = 5e-5
    max_parallel = 1
    capabilities = 'petsc>=3.20'
    requirement = 'The split Cahn-Hilliard kernels of the factored Schur shell test deck shall have a '
                  'Jacobian that matches the finite-difference Jacobian.'
  []

  [requirements]
    requirement = 'The factored Schur preconditioner of the split Cahn-Hilliard system shall stop with '
                  'an error naming the cause'
    [wrong_mobility]
      type = RunException
      input = square_split_ch.i
      cli_args = 'Preconditioning/fs_factored/mobility=2.5 Executioner/num_steps=1'
      expect_err = 'block check failed at build 1: beta_fit = 0\.[34][0-9]* against kappa/M = 0\.8 '
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when its mobility does not match the one of the assembled blocks,'
    []
    [shell_option]
      type = RunException
      input = square_split_ch.i
      cli_args = '-fieldsplit_c_pc_type hypre Executioner/num_steps=1'
      expect_err = "requires '-fieldsplit_c_pc_type shell' under the concentration split 'c'.*found 'hypre'"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when the Schur complement sub-solver is not a shell,'
    []
    [variable_scaling]
      type = RunException
      input = square_split_ch.i
      cli_args = 'Variables/chem_pot_c/scaling=2 Executioner/num_steps=1'
      expect_err = '\) = 2 \(must equal 1 within 1e-10\)'
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when a variable is scaled,'
    []
    [time_integrator]
      type = RunException
      input = square_split_ch.i
      cli_args = 'Executioner/scheme=bdf2 Executioner/num_steps=1'
      expect_err = "requires the implicit Euler time integrator on the concentration 'c'.*found BDF2"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when the time integrator is not implicit Euler,'
    []
    [split_order]
      type = RunException
      input = square_split_ch.i
      cli_args = "Preconditioning/fs_factored/wc/splitting='c w' Executioner/num_steps=1"
      expect_err = 'must list the chemical potential split first'
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when the concentration split is listed first,'
    []
    [schur_factorization]
      type = RunException
      input = square_split_ch.i
      cli_args = '-pc_fieldsplit_schur_fact_type lower Executioner/num_steps=1'
      expect_err = "requires the full Schur factorization under its top split 'wc'.*found "
                   "'-pc_fieldsplit_schur_fact_type lower'"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when an option replaces the full Schur factorization of the top split,'
    []
    [schur_preconditioning_matrix]
      type = RunException
      input = square_split_ch.i
      cli_args = '-pc_fieldsplit_schur_precondition selfp Executioner/num_steps=1'
      expect_err = "found a FieldSplit whose Schur complement preconditioning matrix is built from "
                   "'SELFP', not from A11"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when an option replaces A11 as the Schur complement preconditioning matrix,'
    []
    [reversed_sign]
      type = RunException
      input = square_split_ch.i
      cli_args = 'Kernels/chem_pot_c_CoefReaction/coefficient=1 Executioner/num_steps=1'
      expect_err = "must be negative: A00 is the chemical potential's block, -Mm"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when the sign of the chemical potential equation is reversed,'
    []
    [finite_element_type]
      type = RunException
      input = square_split_ch.i
      cli_args = 'Mesh/square/elem_type=QUAD9 Variables/chem_pot_c/order=SECOND '
                 'Executioner/num_steps=1'
      expect_err = "requires the variables 'c' and 'chem_pot_c' to have the same finite element "
                   "type and the same block restriction.*found LAGRANGE of order 1.*LAGRANGE of "
                   "order 2"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when the two variables differ in finite element type, and'
    []
    [factor_solver_type]
      type = RunException
      input = square_split_ch.i
      cli_args = '-fieldsplit_c_hessian_factor_ksp_type gmres Executioner/num_steps=1'
      expect_err = "requires the factor solver under the options prefix "
                   "'-fieldsplit_c_hessian_factor_' to be preonly.*found 'gmres'"
      max_parallel = 1
      capabilities = 'petsc>=3.20'
      detail = 'when an option replaces the preonly solver of a factor.'
    []
  []

