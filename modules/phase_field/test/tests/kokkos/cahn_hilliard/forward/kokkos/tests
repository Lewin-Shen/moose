[Tests]
  issues = '#30655'
  design = 'KokkosKernels/index.md'

  # G1 (port 02 conventions): hand-coded Jacobians of KokkosMatDiffusion, KokkosCoupledMaterialDerivative,
  # KokkosCHFreeEnergy and KokkosCHMobility against PETSc finite differences, NEWTON, SMP full = true,
  # one step, from the deterministic function initial condition inside (0, 1).
  # the CPU control gives 2.45e-8 on this deck (cpu_control/jac_calphad_cpu); a failure with the CPU twin at the same
  # level is the tester's floor, not the code.
  [jac_calphad]
    type = PetscJacobianTester
    input = ch_fwd_kokkos.i
    ratio_tol = 5e-8
    difference_tol = 5e-5
    run_sim = True
    max_parallel = 1
    cli_args = 'Outputs/csv=false Outputs/exodus=false Executioner/num_steps=1'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The hand-coded Kokkos forward-split Cahn-Hilliard Jacobian with the REDLICH_KISTER free energy shall pass finite-difference comparison.'
  []
  [jac_poly]
    type = PetscJacobianTester
    input = ch_fwd_kokkos_poly.i
    ratio_tol = 5e-8
    difference_tol = 5e-5
    run_sim = True
    max_parallel = 1
    cli_args = 'Outputs/csv=false Outputs/exodus=false Executioner/num_steps=1'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The hand-coded Kokkos forward-split Cahn-Hilliard Jacobian with the DOUBLE_WELL free energy shall pass finite-difference comparison.'
  []
  [jac_degenerate]
    type = PetscJacobianTester
    input = ch_fwd_kokkos_degenerate.i
    ratio_tol = 5e-8
    difference_tol = 5e-5
    run_sim = True
    max_parallel = 1
    cli_args = 'Outputs/csv=false Outputs/exodus=false Executioner/num_steps=1'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos forward-split Jacobian with the degenerate mobility (the dD/du term of KokkosMatDiffusion and dM/dc of KokkosCHMobility) shall pass finite-difference comparison.'
  []
  [jac_coupled]
    type = PetscJacobianTester
    input = ch_fwd_kokkos_coupled.i
    allow_test_objects = true
    ratio_tol = 5e-8
    difference_tol = 5e-5
    run_sim = True
    max_parallel = 1
    cli_args = 'Outputs/csv=false Outputs/exodus=false Executioner/num_steps=1'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The cross-derivative Jacobian blocks of KokkosMatDiffusion and KokkosCoupledMaterialDerivative (coupled_variables, the uncoupled-v diagonal, dD/dv) shall pass finite-difference comparison.'
  []

  # G2: the Kokkos result against the committed gold in gold/, generated by the CPU control decks of ../cpu_control
  # on the same binary (the regeneration commands are in the port 02 tier 2 record), 1 and 4 ranks
  [match_calphad]
    type = Exodiff
    input = ch_fwd_kokkos.i
    exodiff = ch_fwd_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    max_parallel = 1
    cli_args = 'Outputs/file_base=ch_fwd_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos forward-split Cahn-Hilliard result with the REDLICH_KISTER free energy shall match its CPU control on one rank.'
  []
  [match_calphad_np4]
    type = Exodiff
    input = ch_fwd_kokkos.i
    exodiff = ch_fwd_np4_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    min_parallel = 4
    max_parallel = 4
    cli_args = 'Outputs/file_base=ch_fwd_np4_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos forward-split Cahn-Hilliard result with the REDLICH_KISTER free energy shall match its CPU control on four ranks.'
  []
  [match_poly]
    type = Exodiff
    input = ch_fwd_kokkos_poly.i
    exodiff = ch_fwd_poly_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    max_parallel = 1
    cli_args = 'Outputs/file_base=ch_fwd_poly_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos forward-split Cahn-Hilliard result with the DOUBLE_WELL free energy shall match its CPU control on one rank.'
  []
  [match_poly_np4]
    type = Exodiff
    input = ch_fwd_kokkos_poly.i
    exodiff = ch_fwd_poly_np4_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    min_parallel = 4
    max_parallel = 4
    cli_args = 'Outputs/file_base=ch_fwd_poly_np4_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos forward-split Cahn-Hilliard result with the DOUBLE_WELL free energy shall match its CPU control on four ranks.'
  []
  [match_degenerate]
    type = Exodiff
    input = ch_fwd_kokkos_degenerate.i
    exodiff = ch_fwd_degenerate_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    max_parallel = 1
    cli_args = 'Outputs/file_base=ch_fwd_degenerate_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos forward-split result with the degenerate mobility shall match its CPU control.'
  []
  [match_coupled]
    type = Exodiff
    input = ch_fwd_kokkos_coupled.i
    allow_test_objects = true
    exodiff = ch_fwd_coupled_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    max_parallel = 1
    cli_args = 'Outputs/file_base=ch_fwd_coupled_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos coupled-argument test system shall match its CPU control.'
  []
[]
