[Tests]
  issues = '#30655'
  design = 'KokkosKernels/index.md'

  # Port 05 on the PFHub Benchmark 2 sphere mesh (a mesh of dimension 2 in 3D coordinates; needs the Kokkos
  # element map with the surface metric). The Exodiff blocks compare against the committed gold/ files,
  # the outputs of ../cpu_control/b2d_sphere_cpu.i on the same binary (Outputs/file_base=<name>, one or
  # four ranks as the block); regenerate the golds with that deck whenever a deck changes.

  # G6: the sphere twin against the CPU control's gold, three steps, the six nodal fields, the f_density
  # field (non-affine quads: the JxW-weighted element average), free_energy and the area integral
  [sphere_match]
    type = Exodiff
    input = b2d_sphere_kokkos.i
    exodiff = b2d_sphere_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    max_parallel = 1
    cli_args = 'Outputs/file_base=b2d_sphere_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos PFHub Benchmark 2 system on the sphere mesh shall match its CPU control on one rank.'
  []
  [sphere_match_np4]
    type = Exodiff
    input = b2d_sphere_kokkos.i
    exodiff = b2d_sphere_np4_out.e
    abs_zero = 1e-10
    rel_err = 5.5e-6
    min_parallel = 4
    max_parallel = 4
    cli_args = 'Outputs/file_base=b2d_sphere_np4_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos PFHub Benchmark 2 system on the sphere mesh shall match its CPU control on four ranks.'
  []

  # G5 (ii) and G6 on the sphere: free_energy and the area integral against the CSV gold
  # gold/b2d_sphere_out.csv, the output of ../cpu_control/b2d_sphere_cpu.i on the same binary
  # (Outputs/file_base=b2d_sphere_out, one rank), at every step (the CSV keeps every step, the Exodus file
  # only the initial and final ones). The design's acceptances are 1e-10 relative on free_energy at step 0
  # and 1e-12 relative on the area; this row applies 1e-10 to both columns at every step, and the area's
  # 1e-12 stays the tester's reducer check on the full-precision values. Measured on one rank: at most
  # 3.6e-16 on free_energy, 2.3e-16 on the area.
  [sphere_free_energy_area]
    type = CSVDiff
    input = b2d_sphere_kokkos.i
    csvdiff = b2d_sphere_out.csv
    rel_err = 1e-10
    abs_zero = 1e-14
    max_parallel = 1
    cli_args = 'Outputs/file_base=b2d_sphere_out'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda'
    requirement = 'The Kokkos PFHub Benchmark 2 system on the sphere mesh shall reproduce the free energy and area integrals of its CPU control within a relative 1e-10 at every step (G5 (ii) and G6).'
  []
[]
