[Tests]
  issues = '#00000'
  design = 'syntax/Kokkos/index.md KokkosDiffusion.md'

  [tilted_plane]
    requirement = 'The Kokkos system shall solve a diffusion problem with a source on a square mesh rotated out of the xy-plane in three-dimensional space and give the result of the host assembly'
    [host]
      type = Exodiff
      input = 'kokkos_tilted_plane.i'
      exodiff = 'kokkos_tilted_plane_out.e'
      cli_args = 'Kernels/dt/type=TimeDerivative Kernels/diff/type=Diffusion Kernels/force/type=BodyForce BCs/left/type=DirichletBC BCs/right/type=NeumannBC Postprocessors/area/type=ElementIntegralVariablePostprocessor Postprocessors/mass/type=ElementIntegralVariablePostprocessor'
      detail = 'when run with the host objects, which produce the gold,'
      compute_devices = 'cpu cuda xpu'
    []
    [kokkos]
      type = Exodiff
      input = 'kokkos_tilted_plane.i'
      exodiff = 'kokkos_tilted_plane_out.e'
      prereq = 'tilted_plane/host'
      detail = 'for the solution computed with the Kokkos objects,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [ad]
      type = Exodiff
      input = 'kokkos_tilted_plane.i'
      exodiff = 'kokkos_tilted_plane_out.e'
      cli_args = 'Kernels/dt/type=KokkosADTimeDerivative Kernels/diff/type=KokkosADDiffusion'
      prereq = 'tilted_plane/kokkos'
      detail = 'and for the solution computed with the Kokkos automatic differentiation kernels.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []

