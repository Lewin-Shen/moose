[Tests]
  issues = '#30655'
  design = 'interfaces/TaggingInterface.md'

  [general]
    requirement = 'The Kokkos system shall support the ability for a specific calculation to fill a labeled '
                  'or "tagged"'

    [tag_vector]
      type = 'Exodiff'
      input = 'kokkos_2d_diffusion_tag_vector.i'
      exodiff = 'kokkos_2d_diffusion_tag_vector_out.e'
      detail = 'numeric vector,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [tag_matrix]
      type = 'Exodiff'
      input = 'kokkos_2d_diffusion_tag_matrix.i'
      exodiff = 'kokkos_2d_diffusion_tag_matrix_out.e'
      detail = 'numeric matrix,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [tag_multiple_vectors]
      type = 'Exodiff'
      input = 'kokkos_2d_diffusion_vector_tag_test.i'
      exodiff = 'kokkos_2d_diffusion_vector_tag_test_out.e'
      detail = 'multiple numeric vectors simultaneously, or'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [tag_multiple_matrices]
      type = 'Exodiff'
      input = 'kokkos_2d_diffusion_matrix_tag_test.i'
      exodiff = 'kokkos_2d_diffusion_matrix_tag_test_out.e'
      detail = 'multiple numeric matrices simultaneously.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []

  [call_residual]
    type = RunApp
    input = 'kokkos_tag_residual_call.i'
    requirement = 'The Kokkos system shall be able to accumulate tagged vectors individually with multiple residual computations.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [systems]
    requirement = 'The Kokkos system shall support filling in labeled or "tagged" vectors or matrices from:'

    [test_tag_itegratedBCs]
      type = 'Exodiff'
      input = 'kokkos_tag_neumann.i'
      exodiff = 'kokkos_tag_neumann_out.e'
      detail = 'integrated boundary conditions,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []

    [test_tag_nodal_kernels]
      type = 'Exodiff'
      input = 'kokkos_tag_nodal_kernels.i'
      exodiff = 'kokkos_tag_nodal_kernels_out.e'
      detail = 'the nodal kernel system,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []

  [written_residual_tags]
    issues = '#<moose-issue>'
    design = 'NonlinearSystem.md'
    requirement = 'The system shall compute the correct solution when a Kokkos residual pass assembles only the '
                  'residual tags its objects write, with'
    [default_tags]
      type = CSVDiff
      input = kokkos_written_residual_tags.i
      csvdiff = kokkos_written_residual_tags_out.csv
      min_parallel = 2
      max_parallel = 2
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      detail = 'objects that write only the time and non-time residual tags,'
    []
    [kernel_writes_residual]
      type = CSVDiff
      input = kokkos_written_residual_tags.i
      csvdiff = kokkos_written_residual_tags_kernel.csv
      cli_args = 'Kernels/diff/vector_tags=residual Outputs/file_base=kokkos_written_residual_tags_kernel'
      min_parallel = 2
      max_parallel = 2
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      detail = 'a kernel that writes the residual tag,'
    []
    [nodal_bc_writes_residual]
      type = CSVDiff
      input = kokkos_written_residual_tags.i
      csvdiff = kokkos_written_residual_tags_bc.csv
      cli_args = 'BCs/active=left Outputs/file_base=kokkos_written_residual_tags_bc'
      min_parallel = 2
      max_parallel = 2
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      detail = 'a nodal boundary condition that writes the residual tag,'
    []
    [nodal_bcs_only_together]
      type = Exodiff
      input = kokkos_nodal_bcs_only_together.i
      exodiff = kokkos_nodal_bcs_only_together_out.e
      min_parallel = 2
      max_parallel = 2
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      detail = 'and a problem with no kernel, whose combined residual and Jacobian pass therefore runs '
               'only nodal boundary conditions.'
    []
  []
[]
